# web の静的ビルドを配信ディレクトリへ置くときの接続先（pnpm deploy:web が読む）。
#   cp .env.deploy.example .env.deploy   # .env.deploy は gitignore 対象
#   pnpm deploy:web            # ビルド → 計画の表示のみ（dry-run）
#   pnpm deploy:web --apply    # ビルド → 実際に書き込む
# 値は sh の `.` で読むので、空白を含む値はクォートする。
#
# 前提: ローカルとリモートの両方に rsync、リモートに POSIX sh があること。
# リモートに rsync が無いと `--apply` の最初の手順で失敗する。

# ssh の宛先（~/.ssh/config の Host 名を推奨。鍵・known_hosts の検証はそちらに従う）。
DEPLOY_STATIC_HOST=my-vps

# 配信ディレクトリ（リモートの絶対パス）。index.html と assets/ がこの直下に来る。
DEPLOY_STATIC_ROOT=/srv/www/seseraki

# 世代の一覧（current.txt / prev.txt）を置く、配信ディレクトリの外のディレクトリ（リモートの絶対パス）。
DEPLOY_STATIC_STATE=/srv/deploy-state/seseraki

# ローカルのビルド成果物（省略時は packages/web/dist）。
# DEPLOY_STATIC_DIST=
