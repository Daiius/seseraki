# ========================================
# Stage 1: ビルド
# ========================================
FROM node:22-slim AS build

WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

# 依存定義だけ先にコピー（ソース変更でキャッシュが壊れにくい）
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/server/package.json ./packages/server/
COPY packages/web/package.json ./packages/web/
COPY packages/worker/package.json ./packages/worker/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY packages/shared/ ./packages/shared/
COPY packages/server/ ./packages/server/

RUN pnpm --filter server build

# ========================================
# Stage 2: 本番イメージ
# ========================================
FROM gcr.io/distroless/nodejs22-debian12:debug

WORKDIR /app

COPY --from=build /workspace/packages/server/dist/server.js ./server.js

# 一括再判定のエントリ。**使い捨てコンテナとして明示的に実行する**（起動時の自動適用にはしない）。
#   docker compose run --rm <service>   # command: ["/app/redetect-tactics.js"]
# distroless は ENTRYPOINT=node なので command はパスだけでよい。
COPY --from=build /workspace/packages/server/dist/redetect-tactics.js ./redetect-tactics.js

# 局面索引の一括再構築のエントリ。**マイグレーション直後に一度流す必要がある**——
# マイグレーションは空の kifu_positions を作るだけなので、これを流さないと
# 既存棋譜が局面検索に 1 件も出ない（初期局面すら 404 になる）。
#   docker compose run --rm <service>   # command: ["/app/rebuild-positions.js"]
COPY --from=build /workspace/packages/server/dist/rebuild-positions.js ./rebuild-positions.js

# 主体側の一括再導出（prd/11 §4.2）と、移行時に 1 回だけ流す名前の設定（同 §6.2）。
#   docker compose run --rm <service>   # command: ["/app/rebuild-subjects.js"]
#   docker compose run --rm <service> /app/backfill-user.js --display "..." --names "..." --apply
COPY --from=build /workspace/packages/server/dist/rebuild-subjects.js ./rebuild-subjects.js
COPY --from=build /workspace/packages/server/dist/backfill-user.js ./backfill-user.js

# マイグレーションのエントリ。**同梱する理由は、適用する SQL とコードのバージョンが
# 構造的に一致すること**（ホストから流す方式は両者がずれても何も警告されない）。
#   docker compose run --rm <service>   # command: ["/app/migrate.js"]
COPY --from=build /workspace/packages/server/dist/migrate.js ./migrate.js

# 生成済みの SQL。⚠ **バンドルには含まれない**（migrator が実行時に fs で読むため）。
# ここを忘れると、本番でマイグレーションを流すまで気づけない。
COPY --from=build /workspace/packages/server/drizzle ./drizzle

CMD ["server.js"]
