# --- Postgres（compose の db。prd/15）---
# 管理ロール（DDL・マイグレーション）。公式イメージが初回起動時にこのロールと DB を作る
POSTGRES_DB=seseraki
POSTGRES_USER=seseraki_admin
POSTGRES_PASSWORD=your-admin-password

# アプリの接続先（server・一括処理・マイグレーションで共通）。ホストから流す *:dev は DB_HOST=localhost に差し替える
DB_HOST=db
# ⚠ DB_PORT は compose 網内の値。ホストから流す *:dev は scripts/db-forward.sh のポート（既定 55432）で上書きされる
DB_PORT=5432
DB_NAME=seseraki
# server ロール（DML のみ）。常駐の server と一括処理（generate-drills など）が使う。
# dev では scripts/postgres-init/10-server-role.sh が空の volume の初回にこのロールを作る
DB_USER=seseraki_server
DB_PASSWORD=your-server-password
# system ロール（DML のみ・BYPASSRLS。RLS を迂回する）。全員ぶんを扱う経路（worker の報告・動画解析の取り込み・
# 一括処理のエントリ）が使う。ログインの経路（DB_USER）とは別のプールで繋ぐ（prd/15 §2・prd/14 §4）。
# 🔒 未設定なら server は起動しない。dev では scripts/postgres-init/20-system-role.sh が空の volume の初回に作る
# （既存の volume は同じスクリプトを db コンテナの中で流す。スクリプトの冒頭を参照）
DB_SYSTEM_USER=seseraki_system
DB_SYSTEM_PASSWORD=your-system-password
# 管理ロール（migrate.ts だけが使う）。dev では POSTGRES_USER / POSTGRES_PASSWORD と同じ値にする
DB_ADMIN_USER=seseraki_admin
DB_ADMIN_PASSWORD=your-admin-password

# --- 旧 MySQL（compose の db-mysql。データ移行の練習が済むまで。server は使わない）---
# 接続先はデータ移行（migrate-from-mysql.ts。prd/15 §6）だけが使う。compose 網の中から流す
MYSQL_HOST=db-mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your-root-password
MYSQL_USER=seseraki-user
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=seseraki
