# worker → server 通信用の API キー
API_KEY=your-api-key

# CORS 許可オリジン（カンマ区切り）。同一オリジン配信が既定なので通常は未設定でよい
# （dev は Vite proxy、本番はリバプロが /api を同一オリジンで server へ渡すため CORS 不要）。
# 別オリジンの web から直接叩く特殊構成のときだけ設定する。
# CORS_ORIGINS=https://seseraki.example.com,https://other.example.com

# 人のログイン（Google。実装は Better Auth。prd/07 §8「環境変数（切り替え後）」）。
# development 以外（本番）では BETTER_AUTH_SECRET / BETTER_AUTH_URL / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET が
# 無いと server が起動しない。dev compose では NODE_ENV=development と BETTER_AUTH_URL を compose.yml が渡すので、
# どれも省略できる（Google を登録しなければ dev ログインだけで動く）。
#
# セッション等の署名鍵（ランダムな長い文字列。例: openssl rand -base64 32）
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# ブラウザから見えるオリジン（/api は付けない。Better Auth が /api/auth を足す）
# BETTER_AUTH_URL=https://seseraki.example.com
# Google の OAuth クライアント。リダイレクト先は <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# 新規 user の作成を許す。**既存アカウントの移行（prd/07 §4）の間だけ true にし、済んだら外して再起動する**。
# development では不要（常に許す）
# AUTH_ALLOW_SIGNUP=true

# 出題の抽出（prd/13 §8）。**採点の許容差とは別のつまみ**——こちらは「どの局面を問題にするか」で、
# 許容差（その手を正解と呼ぶか）は閲覧者の設定として web が持つ。
# 変えたら `pnpm drills:generate` を流し直す（既定 dry-run / GENERATE_DRILLS_APPLY=1 で実書込）。
# DRILL_BLUNDER_CP=600        # 悪手とみなす損失（cp）。既定は shared の DEFAULT_THRESHOLDS
# DRILL_MATE_MAX_PLIES=10     # 出題する詰みの上限（engine の plies。詰将棋の「N手詰」ではない）
