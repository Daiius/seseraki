ENGINE_PATH=../../engines/yaneuraou-material
ENGINE_THREADS=1
ENGINE_DEPTH=10
# 詰めろ probe（prd/12 §2.2）だけの思考時間(ms)。未設定なら棋譜解析と同じ予算
# ENGINE_PROBE_MOVETIME=1000
# Docker 外 worker は server の /api proxy（＝web の公開口）経由で接続する。
# server はホストに公開しないため localhost:4000 ではなく web(Vite) の 5173 を指す。
SERVER_URL=http://localhost:5173
POLL_INTERVAL_MS=10000
USE_MOCK=true
