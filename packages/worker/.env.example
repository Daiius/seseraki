# Docker 外で動かす worker の雛形（cp .env.example .env。prd/02 §6）。
# ENGINE_PATH は手元でビルドしたやねうら王の実行ファイルを絶対パスで指す（mock でも存在を確かめる）。
# リポジトリにエンジンの実行ファイルは無い。dev / 本番の worker イメージは Dockerfile がビルドして
# /usr/local/bin/yaneuraou に置く（dev は Dockerfile の MATERIAL 版・本番は Dockerfile.prod の SFNN 版）。
ENGINE_PATH=/path/to/yaneuraou
ENGINE_THREADS=1
ENGINE_DEPTH=10
# Docker 外 worker は server の /api proxy（＝web の公開口）経由で接続する。
# server はホストに公開しないため localhost:4000 ではなく web(Vite) の 5173 を指す。
SERVER_URL=http://localhost:5173
POLL_INTERVAL_MS=10000
# server に繋がず固定の局面を読むだけの mock（既定は false = server に繋ぐ。省略すると API_KEY が要る）
USE_MOCK=true
