{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsx esbuild.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx migrate.ts",
    "db:baseline": "tsx baseline.ts",
    "db:push": "drizzle-kit push --force",
    "tactics:redetect": "tsx redetect-tactics.ts"
  },
  "exports": {
    ".": {
      "types": "./src/route.ts"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "1.0.0-beta.22",
    "hono": "^4.12.25",
    "mysql2": "^3.22.2",
    "shared": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "drizzle-kit": "1.0.0-beta.23",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "vitest": "^4.1.5"
  }
}
