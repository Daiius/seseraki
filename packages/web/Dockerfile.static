# 本番 web の静的ビルド（packages/web/dist）だけを入れたイメージ（prd/02 §5.2）。動かすためのイメージではない。
# 本番の VPS は、このイメージを pull して起動せずに（docker create → docker cp）/site の中身を取り出し、
# 配信ディレクトリへ「世代」として置く。コンテナは作るだけで起動しないので、シェルも node も要らない（scratch）。
# 手で中を見るときも起動はできない: docker create --entrypoint / <image> → docker cp <cid>:/site/. <dir> → docker rm <cid>
#
# 🔒 ビルドはこのイメージの中ではしない。.github/workflows/build-push-web.yml が runner の上で
#   エンジン（pnpm engine:build。Docker の emsdk で上流をビルドし、評価関数を取得する）と
#   web（ENGINE_REQUIRED=1 pnpm --filter web build。version.json は Vite のプラグインが git から作る）を作り、
#   できた packages/web/dist を**ビルドの文脈そのもの**として渡す（docker build -f packages/web/Dockerfile.static packages/web/dist）。
#   理由: 根の .dockerignore は **/dist と .git を除くので、根を文脈にすると dist が入らず、中でビルドすると version.json の commit が unknown になる。
#   ⚠ 文脈の根（dist）の .dockerignore と、このファイルの隣の Dockerfile.static.dockerignore は読まれる。どちらも置かない。
# 手元で作るとき（ふつうは作らない）: 上の 2 つのビルドのあと、
#   docker build -f packages/web/Dockerfile.static --build-arg GIT_COMMIT=$(git rev-parse HEAD) packages/web/dist

# ---- check: 中身を確かめる（成果物には残らない） -----------------------------------------
# server の Dockerfile.prod の build と同じ系統（Node 24）。version.json を JSON として読むために node を使う。
FROM node:24-slim AS check
COPY . /site
# 🔒 GIT_COMMIT は 40 桁の小文字の 16 進だけを受け、ほかはビルドを止める（下の ENV GIT_COMMIT にそのまま入り、
#    本番の VPS はこれと /site/version.json の最上位の commit を照合する）。
#    version.json の commit も同じ値であることをここで確かめる（違うイメージは VPS で切り替わらずに止まるので、作らない）。
#    index.html（VPS の既定の STATIC_MARKER）と engine/manifest.json（ENGINE_REQUIRED=1 のビルドなら必ずある）も確かめる。
ARG GIT_COMMIT=unknown
#    値そのもの（改行を含まない 40 桁）を node で確かめる（grep は行ごとに見るので、複数行の値の 1 行だけが合っても通ってしまう）。
#    値は引数でなく環境変数（ARG は RUN の環境に入る）で渡す（引数だと `--` などが node のオプションとして読まれ、検証が飛ばされうる）。
RUN set -eu; \
    for f in index.html version.json engine/manifest.json; do \
      [ -f "/site/$f" ] || { echo "/site/$f が無い（packages/web/dist を文脈にしているか）" >&2; exit 1; }; \
    done; \
    node -e ' \
      if (!/^[0-9a-f]{40}$/.test(process.env.GIT_COMMIT)) { \
        console.error(`GIT_COMMIT は 40 桁の小文字の 16 進: ${JSON.stringify(process.env.GIT_COMMIT)}`); \
        process.exit(1); \
      } \
      const v = JSON.parse(require("fs").readFileSync("/site/version.json", "utf8")); \
      if (v === null || typeof v !== "object" || v.commit !== process.env.GIT_COMMIT) { \
        console.error(`version.json の commit（${v && v.commit}）が GIT_COMMIT（${process.env.GIT_COMMIT}）と違う`); \
        process.exit(1); \
      } \
      console.log(JSON.stringify(v)); \
    '

# ---- 成果物だけ ---------------------------------------------------------------------------
FROM scratch
COPY --from=check /site /site
# 本番の VPS は、取り出す前にこのコミットと /site/version.json の commit を照合する（server のイメージと同じ環境変数）。
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT
