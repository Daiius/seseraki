# 上流と評価関数の固定値。build.sh / fetch-eval.sh はここから値を読む（値をほかに書かない）。
# 書式: KEY=VALUE（1 行 1 項目・引用符なし・値に空白を入れない）。# で始まる行は注釈。
# 値を変えたら pnpm engine:build を流し直す（成果物の置き場と manifest の buildId が変わる）。

# --- エンジン（やねうら王・GPL-3.0） ---
# 対応ソースはこのリポジトリのこのコミット。パッチは当てない。
YANEURAOU_REPO=https://github.com/yaneurao/YaneuraOu
YANEURAOU_SHA=c1b80eaa09fe13d5f12b1599d1ae4d53c224de30
# Emscripten の Docker イメージ（タグが版）。
EMSDK_IMAGE=emscripten/emsdk:3.1.43
# WASM の初期メモリ（上流の script/wasm_build.js が渡す値と同じ）。
EM_INITIAL_MEMORY_SIZE=167772160
# ホストに 7z が無いときに、展開に使う使い捨てコンテナのイメージ（中で p7zip-full を入れる）。
EVAL_EXTRACT_IMAGE=debian:bookworm-slim

# --- 評価関数の一覧 ---
# 配る評価関数の id（: 区切り）と既定。id ごとの値は EVAL_<id を大文字にしたもの>_<項目> に書く。
# 評価関数の型（arch）はエンジンのコンパイル時に固定なので、EDITION ごとにエンジンを 1 本ビルドする
# （EDITION が同じ評価関数はエンジンを共有する）。
EVAL_IDS=tsuyo11mini:tsuyo11micro
EVAL_DEFAULT=tsuyo11mini

# 項目:
#   NAME            表示名
#   EDITION         上流の Makefile の YANEURAOU_EDITION（arch を決める）
#   EXPORT_NAME     グルーが公開する関数名（EDITION ごとに別名にする。build.sh が成果物と照合する）
#   FV_SCALE        エンジンに渡す FV_SCALE（手元 worker・悪手判定の閾値と尺度を揃える。作者の推奨 24 は採らない）
#   URL             配布物（7z）。ARCHIVE_BYTES / ARCHIVE_SHA256 はその大きさと sha256
#   NN_* / PROGRESS_*  アーカイブの中の nn.bin / progress.bin の大きさと sha256。
#                   取り出すのはこの 2 つだけ（eval_options.txt は FV_SCALE を 24 に上書きするので置かない）
#   LICENSE         評価関数のライセンス。LICENSE_FILE はその許諾文（このパッケージからの相対）
#   SOURCE_URL      出典（作者による公開の告知）

# --- つようら王11mini（既定。評価の精度が高い） ---
